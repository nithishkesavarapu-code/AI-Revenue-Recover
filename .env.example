# Infrastructure
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/revenue_recovery?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=3002
API_URL="http://localhost:3002"
WEB_ORIGIN="http://localhost:3100"

# API access
API_AUTH_TOKEN=""

# Recovery controls
BACKGROUND_JOBS_ENABLED=false
PAYMENT_PROVIDER=simulated
RECOVERY_SEND_LIVE_MESSAGES=false
RECOVERY_SEQUENCE_STEPS_JSON=""
CONTACT_WINDOW_START_IST=9
CONTACT_WINDOW_END_IST=20
PTP_REMINDER_LEAD_HOURS=24

# AI
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional messaging providers
EMAIL_PROVIDER=simulated
RESEND_API_KEY=""
EMAIL_FROM=""
RESEND_WEBHOOK_SECRET=""
RESEND_REPLY_TO_DOMAIN=""
VOICE_PROVIDER=simulated
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WEBHOOK_AUTH_TOKEN=""
